int main()
{
    // Matrix A in triplet form
    int A[6][3] =
    {
        {3, 3, 5},
        {0, 0, 1},
        {0, 2, 2},
        {1, 1, 3},
        {2, 0, 4},
        {2, 2, 5}
    };

    // Matrix B in triplet form
    int B[6][3] =
    {
        {3, 3, 5},
        {0, 1, 6},
        {0, 2, 2},
        {1, 0, 7},
        {2, 0, 4},
        {2, 2, 1}
    };

    int C[20][3];

    if (A[0][0] != B[0][0] ||
        A[0][1] != B[0][1])
    {
        cout << "Addition not possible.";
        return 0;
    }

    int i = 1, j = 1, k = 1;

    C[0][0] = A[0][0];
    C[0][1] = A[0][1];

    while (i <= A[0][2] && j <= B[0][2])
    {
        if (A[i][0] == B[j][0] &&
            A[i][1] == B[j][1])
        {
            int sum = A[i][2] + B[j][2];

            if (sum != 0)
            {
                C[k][0] = A[i][0];
                C[k][1] = A[i][1];
                C[k][2] = sum;
                k++;
            }

            i++;
            j++;
        }
        else if (A[i][0] < B[j][0] ||
                (A[i][0] == B[j][0] &&
                 A[i][1] < B[j][1]))
        {
            C[k][0] = A[i][0];
            C[k][1] = A[i][1];
            C[k][2] = A[i][2];

            i++;
            k++;
        }
        else
        {
            C[k][0] = B[j][0];
            C[k][1] = B[j][1];
            C[k][2] = B[j][2];

            j++;
            k++;
        }
    }

    while (i <= A[0][2])
    {
        C[k][0] = A[i][0];
        C[k][1] = A[i][1];
        C[k][2] = A[i][2];

        i++;
        k++;
    }

    while (j <= B[0][2])
    {
        C[k][0] = B[j][0];
        C[k][1] = B[j][1];
        C[k][2] = B[j][2];

        j++;
        k++;
    }

    C[0][2] = k - 1;

    cout << "Addition in Triplet Form:\n";

    for (int i = 0; i < k; i++)
    {
        cout << C[i][0] << " "
             << C[i][1] << " "
             << C[i][2] << endl;
    }

    return 0;
}
