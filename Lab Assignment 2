#include <iostream>
using namespace std;

int main()
{
    // A = 2 x 3
    int A[4][3] =
    {
        {2, 3, 2},
        {0, 0, 2},
        {1, 2, 3}
    };

    // B = 3 x 2
    int B[5][3] =
    {
        {3, 2, 3},
        {0, 0, 1},
        {1, 1, 2},
        {2, 0, 3}
    };

    // Check multiplication condition
    if (A[0][1] != B[0][0])
    {
        cout << "Multiplication not possible.";
        return 0;
    }

    // Convert triplet to normal matrix
    int matA[2][3] = {0};
    int matB[3][2] = {0};

    for (int i = 1; i <= A[0][2]; i++)
    {
        matA[A[i][0]][A[i][1]] = A[i][2];
    }

    for (int i = 1; i <= B[0][2]; i++)
    {
        matB[B[i][0]][B[i][1]] = B[i][2];
    }

    // Result matrix
    int result[2][2] = {0};

    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            for (int k = 0; k < 3; k++)
            {
                result[i][j] += matA[i][k] * matB[k][j];
            }
        }
    }

    // Convert result to triplet
    int C[10][3];
    int count = 0;

    C[0][0] = 2;
    C[0][1] = 2;

    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            if (result[i][j] != 0)
            {
                count++;

                C[count][0] = i;
                C[count][1] = j;
                C[count][2] = result[i][j];
            }
        }
    }

    C[0][2] = count;

    cout << "Multiplication in Triplet Form:\n";

    for (int i = 0; i <= count; i++)
    {
        cout << C[i][0] << " "
             << C[i][1] << " "
             << C[i][2] << endl;
    }

    return 0;
}
