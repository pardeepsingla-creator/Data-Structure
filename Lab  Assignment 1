Q:1 Develop a Menu driven program to demonstrate the following operations of arrays --Menu--
1. Create
2. Display
3. Insert
4. Delete
5. Linear Search
6. Exit
#include <iostream>
using namespace std;

#define MAX 100

int main()
{
    int arr[MAX];
    int n = 0;
    int choice, i, pos, value, key;

    while (true)
    {
        cout << "\n\n----- ARRAY MENU -----";
        cout << "\n1. Create";
        cout << "\n2. Display";
        cout << "\n3. Insert";
        cout << "\n4. Delete";
        cout << "\n5. Linear Search";
        cout << "\n6. Exit";
        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                // Create
                cout << "Enter number of elements: ";
                cin >> n;

                if (n < 0 || n > MAX)
                {
                    cout << "Invalid size!";
                    n = 0;
                    break;
                }

                cout << "Enter " << n << " elements:\n";
                for (i = 0; i < n; i++)
                {
                    cin >> arr[i];
                }

                cout << "Array created successfully.";
                break;

            case 2:
                // Display
                if (n == 0)
                {
                    cout << "Array is empty.";
                }
                else
                {
                    cout << "Array elements are: ";
                    for (i = 0; i < n; i++)
                    {
                        cout << arr[i] << " ";
                    }
                }
                break;

            case 3:
                // Insert
                if (n == MAX)
                {
                    cout << "Array is full. Cannot insert.";
                    break;
                }

                cout << "Enter position (1 to " << n + 1 << "): ";
                cin >> pos;

                if (pos < 1 || pos > n + 1)
                {
                    cout << "Invalid position.";
                    break;
                }

                cout << "Enter value to insert: ";
                cin >> value;

                for (i = n; i >= pos; i--)
                {
                    arr[i] = arr[i - 1];
                }

                arr[pos - 1] = value;
                n++;

                cout << "Element inserted successfully.";
                break;

            case 4:
                // Delete
                if (n == 0)
                {
                    cout << "Array is empty. Cannot delete.";
                    break;
                }

                cout << "Enter position to delete (1 to " << n << "): ";
                cin >> pos;

                if (pos < 1 || pos > n)
                {
                    cout << "Invalid position.";
                    break;
                }

                for (i = pos - 1; i < n - 1; i++)
                {
                    arr[i] = arr[i + 1];
                }

                n--;

                cout << "Element deleted successfully.";
                break;

            case 5:
                // Linear Search
                if (n == 0)
                {
                    cout << "Array is empty.";
                    break;
                }

                cout << "Enter element to search: ";
                cin >> key;

                for (i = 0; i < n; i++)
                {
                    if (arr[i] == key)
                    {
                        cout << "Element found at position "
                             << i + 1 << ".";
                        break;
                    }
                }

                if (i == n)
                {
                    cout << "Element not found.";
                }
                break;

            case 6:
                // Exit
                cout << "Exiting program...";
                return 0;

            default:
                cout << "Invalid choice! Please try again.";
        }
    }

    return 0;
}

Q:2 Design the logic to remove the duplicate elements from an Array and after the deletion the array should contain the unique elements.
Ans:
#include <iostream>
using namespace std;

int main()
{
    int arr[100], n;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter array elements:\n";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    // Remove duplicate elements
    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (arr[i] == arr[j])
            {
                // Shift elements to the left
                for (int k = j; k < n - 1; k++)
                {
                    arr[k] = arr[k + 1];
                }

                n--;
                j--;
            }
        }
    }

    cout << "\nArray after removing duplicates:\n";

    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}

Q:3 Design the logic of a program to rotate a 1-D array by K positions.
e.g., for A = {1,2,3,4,5} and K = 2, the left rotation is {3,4,5,1,2} and the right rotation is {4,5,1,2,3}.
Ans: 
#include <iostream>
using namespace std;

int main()
{
    int arr[100], n, k;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter array elements:\n";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    cout << "Enter number of positions to rotate: ";
    cin >> k;

    // If k is greater than n
    k = k % n;

    // Rotate array to the right
    for (int r = 1; r <= k; r++)
    {
        int last = arr[n - 1];

        for (int i = n - 1; i > 0; i--)
        {
            arr[i] = arr[i - 1];
        }

        arr[0] = last;
    }

    cout << "\nArray after rotation:\n";

    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}

Q:4 Implement the logic to (a) Reverse the elements of an array
(b) find the matrix multiplication
(c) find the transpose of a matrix
Ans: (a)
#include <iostream>
using namespace std;

int main()
{
    int arr[100], n;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter array elements:\n";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    // Reverse the array
    int start = 0, end = n - 1;

    while (start < end)
    {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;

        start++;
        end--;
    }

    cout << "Reversed array:\n";
    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
(b)
#include <iostream>
using namespace std;

int main()
{
    int A[10][10], B[10][10], C[10][10];
    int r1, c1, r2, c2;

    cout << "Enter rows and columns of first matrix: ";
    cin >> r1 >> c1;

    cout << "Enter rows and columns of second matrix: ";
    cin >> r2 >> c2;

    if (c1 != r2)
    {
        cout << "Matrix multiplication is not possible.";
        return 0;
    }

    cout << "Enter elements of first matrix:\n";
    for (int i = 0; i < r1; i++)
    {
        for (int j = 0; j < c1; j++)
        {
            cin >> A[i][j];
        }
    }

    cout << "Enter elements of second matrix:\n";
    for (int i = 0; i < r2; i++)
    {
        for (int j = 0; j < c2; j++)
        {
            cin >> B[i][j];
        }
    }

    // Initialize and multiply
    for (int i = 0; i < r1; i++)
    {
        for (int j = 0; j < c2; j++)
        {
            C[i][j] = 0;

            for (int k = 0; k < c1; k++)
            {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    cout << "Resultant matrix:\n";
    for (int i = 0; i < r1; i++)
    {
        for (int j = 0; j < c2; j++)
        {
            cout << C[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
